FROM rust:1.97-bookworm AS builder

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

RUN cargo fetch --locked
RUN cargo build --release --locked --package tunnet-relay \
    && strip target/release/tunnet-relay

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/tunnet-relay /usr/local/bin/tunnet-relay

# 80/443 production HTTP(S), 3340 iroh-relay --dev, 9090 metrics, 7842 QAD QUIC
EXPOSE 80 443 3340 9090 7842

ENTRYPOINT ["tunnet-relay"]
CMD ["run"]
