FROM oven/bun:1 AS builder

WORKDIR /src

COPY package.json bun.lock ./
COPY apps/cloud/package.json apps/cloud/
COPY apps/dashboard/package.json apps/dashboard/
COPY apps/desktop/package.json apps/desktop/
COPY apps/docs/package.json apps/docs/
COPY apps/management/package.json apps/management/
COPY packages/api/package.json packages/api/
COPY packages/cli/package.json packages/cli/
COPY packages/client/package.json packages/client/
COPY packages/db/package.json packages/db/
COPY packages/env/package.json packages/env/
COPY packages/ip/package.json packages/ip/
COPY packages/license/package.json packages/license/
COPY packages/policy-engine/package.json packages/policy-engine/
COPY packages/tunnet/package.json packages/tunnet/
COPY packages/ui/package.json packages/ui/
COPY crates/tunnet-node-napi/package.json crates/tunnet-node-napi/

# --linker=hoisted: flat node_modules layout that Vite can resolve
RUN bun install --frozen-lockfile --linker=hoisted

COPY packages/ packages/
COPY apps/dashboard/ apps/dashboard/

ARG MANAGEMENT_URL=http://management:3000
ARG CONTROL_PLANE_URL=http://control:8080
ARG DASHBOARD_URL=
ENV NODE_ENV=production
ENV MANAGEMENT_URL=${MANAGEMENT_URL}
ENV CONTROL_PLANE_URL=${CONTROL_PLANE_URL}
ENV DASHBOARD_URL=${DASHBOARD_URL}

RUN cd apps/dashboard && bunx --bun vite build

FROM oven/bun:1-slim

WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV NITRO_HOST=0.0.0.0
ENV NITRO_PORT=3000
ARG MANAGEMENT_URL=http://management:3000
ARG CONTROL_PLANE_URL=http://control:8080
ARG DASHBOARD_URL=
ENV MANAGEMENT_URL=${MANAGEMENT_URL}
ENV CONTROL_PLANE_URL=${CONTROL_PLANE_URL}
ENV DASHBOARD_URL=${DASHBOARD_URL}

COPY --from=builder /src/apps/dashboard/.output .output
COPY --from=builder /src/node_modules node_modules
COPY --from=builder /src/packages packages
COPY --from=builder /src/package.json package.json

EXPOSE 3000
CMD ["bun", "run", ".output/server/index.mjs"]
